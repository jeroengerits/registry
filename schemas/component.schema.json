{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jeroengerits/registry/schemas/component.schema.json",
  "title": "UI component manifest",
  "description": "The schema for the root ui.json file in a component repository.",
  "type": "object",
  "required": ["schemaVersion", "name", "files", "dependencies", "components"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "description": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "target"],
        "properties": {
          "source": { "$ref": "#/$defs/nonBlankString" },
          "target": { "$ref": "#/$defs/nonBlankString" }
        },
        "additionalProperties": false
      }
    },
    "dependencies": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/nonBlankString" },
      "additionalProperties": { "$ref": "#/$defs/nonBlankString" }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["repository"],
        "properties": {
          "repository": { "$ref": "#/$defs/nonBlankString" },
          "version": { "$ref": "#/$defs/nonBlankString" }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "nonBlankString": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    }
  },
  "additionalProperties": false
}
